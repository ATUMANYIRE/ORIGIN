# ====================================================================
# ORIGIN — Production Environment Configuration Example
# Give software the ability to understand itself.
# ====================================================================

# Gateway Exposure Port (HTTP)
PORT=80

# Public URL reachable by browser clients
NEXT_PUBLIC_API_URL=http://localhost

# Database Security (PostgreSQL 16 SCRAM-SHA-256)
POSTGRES_USER=origin
POSTGRES_DB=origin
POSTGRES_PASSWORD=change_me_to_a_cryptographically_secure_password_64chars

# Redis Distributed Cache & Pub/Sub
REDIS_PASSWORD=change_me_to_a_secure_redis_password_64chars

# Origin API Authentication Key (Used by SDK, Telemetry Agents, Admin CLI)
ORIGIN_API_KEY=origin_prod_sec_key_change_me_to_64char_random_token

# CORS Allowed Origin Domains (JSON string array)
CORS_ORIGINS=["https://origin.yourdomain.com","http://localhost:3000","http://localhost"]
