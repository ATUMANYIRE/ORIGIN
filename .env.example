# ORIGIN Platform Environment Configuration (Template)
# Copy to .env for local development. Never commit real secrets.

ORIGIN_ENV=development
ORIGIN_API_KEY=origin-dev-scientific-key-2026
ORIGIN_JWT_SECRET=replace-with-32-byte-secret-in-production

# Database & Redis
DATABASE_URL=postgresql+asyncpg://origin:origin_password@localhost:5438/origin
REDIS_URL=redis://localhost:6399/0

# Laboratory Internal Controller URL
LAB_CONTROLLER_URL=http://localhost:8099
LAB_AUTO_SEED=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
